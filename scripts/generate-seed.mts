/**
 * Writes supabase/seed.sql from the local catalog in data/*.ts, so a new Supabase project starts
 * with the same models, accessories, brands and hero video the site shows today.
 *
 *   npm run db:seed-sql      → then paste supabase/seed.sql into the Supabase SQL Editor once.
 *
 * Photos keep their /images/… paths (files in /public), which the site and admin both understand.
 * Everything is inserted as PUBLISHED, matching what is live now. Safe to re-run: existing rows
 * (same slug / name) are left untouched.
 */
import { writeFileSync } from "node:fs";
import { accessories } from "@/data/accessories";
import { brands, heroVideo } from "@/data/home";
import { models } from "@/data/models";

const q = (v: string | null | undefined) => (v == null ? "null" : `'${v.replace(/'/g, "''")}'`);
const b = (v: boolean) => (v ? "true" : "false");
const json = (v: unknown) => `${q(JSON.stringify(v))}::jsonb`;
const textArray = (v: string[]) => (v.length ? `array[${v.map(q).join(", ")}]::text[]` : "'{}'::text[]");

/** Tags added automatically from category / "new" (lib/data/rows.ts → toAccessory): not stored. */
const AUTO_TAGS = new Set(["accessory", "helmet", "apparel", "parts", "new"]);

const lines: string[] = [
  "-- Generated by scripts/generate-seed.mts from data/*.ts. Do not edit by hand: change the data and re-run.",
  "-- Run once in the Supabase SQL Editor, AFTER supabase/migrations. Safe to re-run (skips existing rows).",
  "begin;",
  "",
  "-- Brands",
  ...brands.map(
    (br, i) => `insert into public.brands (name, logo_path, sort, published) values (${q(br.name)}, ${q(br.logo ?? null)}, ${i * 10}, true) on conflict (name) do nothing;`,
  ),
  "",
  "-- Models",
  ...models.map(
    (m, i) =>
      `insert into public.models (slug, brand, name, type, cc, licence, price, is_new, image_path, sort, published) values (${q(m.slug)}, ${q(m.brand)}, ${q(m.name)}, ${q(m.type)}, ${m.cc}, ${q(m.licence)}, ${m.price}, ${b(m.isNew)}, ${q(m.image ?? null)}, ${i * 10}, true) on conflict (slug) do nothing;`,
  ),
  "",
  "-- Accessories",
  ...accessories.map(
    (a, i) =>
      `insert into public.accessories (slug, brand, name, category, price, is_new, image_path, cutout, meta, tags, specs, colours, sort, published) values (${q(a.slug)}, ${q(a.brand)}, ${q(a.name)}, ${q(a.category)}, ${a.price}, ${b(a.isNew)}, ${q(a.image ?? null)}, ${b(Boolean(a.cutout))}, ${q(a.meta ?? "")}, ${textArray((a.tags ?? []).filter((t) => !AUTO_TAGS.has(t)))}, ${json(a.specs ?? [])}, ${json(a.colours ?? [])}, ${i * 10}, true) on conflict (slug) do nothing;`,
  ),
  "",
  "-- Hero video + shots (only if no banner has been saved yet)",
  `insert into public.hero_video (id, video_path, poster_path, duration) values (1, ${q(heroVideo.src)}, ${q(heroVideo.poster)}, ${heroVideo.duration}) on conflict (id) do nothing;`,
  "insert into public.banner_slides (start_seconds, label, sort)",
  "select * from (values",
  heroVideo.slides.map((s, i) => `  (${s.start}, ${q(s.label)}, ${i})`).join(",\n"),
  ") as v(start_seconds, label, sort)",
  "where not exists (select 1 from public.banner_slides);",
  "",
  "commit;",
  "",
];

const out = new URL("../supabase/seed.sql", import.meta.url);
writeFileSync(out, lines.join("\n"), "utf8");
console.log(`Wrote ${out.pathname}: ${brands.length} brands, ${models.length} models, ${accessories.length} accessories, ${heroVideo.slides.length} hero shots.`);
