# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# In production, set the same names in Vercel → Project → Settings → Environment Variables.
# Server-only secrets are read through lib/env.ts (no fallbacks: a missing one throws).

# ── Site (not secret) ───────────────────────────────────────────────
# Public address, e.g. https://www.example.com (used for sitemap, robots, share previews)
SITE_URL=

# ── Email: form submissions (Phase 3) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. "NAS <info@example.com>"
MAIL_FROM=
# Shop inbox that receives the forms
MAIL_TO=

# ── Cloudflare Turnstile: "are you human" check (OPTIONAL) ──────────
# Leave both empty to keep it off (forms use the spam trap + rate limit).
# Set BOTH to switch it on. Site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Supabase (Phase 4) ──────────────────────────────────────────────
# URL and publishable key are public; access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key bypasses Row Level Security: server-only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional, local only: database connection string for running SQL setup scripts. Not used by the website.
SUPABASE_DB_URL=

# The one admin account in Supabase Auth. The login page asks only for its password.
ADMIN_EMAIL=
